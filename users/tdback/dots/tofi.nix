{
  programs.tofi = {
    enable = true;
    settings = {
      require-match = true;
      history = true;
      prompt-text = "run: ";
      prompt-padding = 0;
      font = "Terminess Nerd Font Mono";
      font-size = 16;
      text-color = "#FFFFFF";
      text-cursor = true;
      background-color = "#000A";
      scale = true;
      horizontal = false;
      anchor = "center";
      height = "100%";
      width = "100%";
      padding-top = "40%";
      padding-left = "40%";
      border-width = 0;
    };
  };
}
